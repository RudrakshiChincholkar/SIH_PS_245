# Application Settings
PROJECT_NAME="AI-based Attendance Monitoring System"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# PostgreSQL Database Configuration
# Do NOT place production secrets here. Use placeholder values.
DB_HOST="localhost"
DB_PORT=5432
DB_USER="your_db_username"
DB_PASSWORD="your_db_password"
DB_NAME="your_db_name"

# Ingestion & Media Upload Settings
MAX_VIDEO_SIZE_MB=200
ALLOWED_VIDEO_EXTENSIONS='[".mp4",".avi",".mov"]'
UPLOAD_DIR="data"

# Part 3 video quality sampling (seconds)
VIDEO_SAMPLE_INTERVAL_SECONDS=10.0
VIDEO_SAMPLE_INTERVAL_MIN=0.5
VIDEO_SAMPLE_INTERVAL_MAX=60.0
VIDEO_QUALITY_BLUR_THRESHOLD=100.0
VIDEO_QUALITY_LOW_LIGHT_THRESHOLD=40.0
VIDEO_QUALITY_OVEREXPOSURE_THRESHOLD=230.0
VIDEO_QUALITY_NEAR_IDENTICAL_MAD_THRESHOLD=1.0
VIDEO_QUALITY_MIN_DECODE_SUCCESS_RATIO=0.8
VIDEO_QUALITY_BLACK_LUMINANCE_THRESHOLD=8.0
VIDEO_QUALITY_FROZEN_MIN_IDENTICAL_PAIRS=3
VIDEO_QUALITY_FROZEN_IDENTICAL_PAIR_RATIO=0.85

# Part 4 CPU-only YOLO person detection (COCO class 0)
PERSON_DETECTOR_MODEL="yolov8n.pt"
PERSON_DETECTION_CONFIDENCE=0.25
PERSON_DETECTION_IOU=0.45
PERSON_DETECTION_DEVICE="cpu"
OCCUPANCY_EVIDENCE_ENABLED=false
OCCUPANCY_EVIDENCE_MAX_FRAMES=20

# Test Database Settings (Isolated database used during automated test runs)
TEST_DB_NAME="sih_attendance_test"
# TEST_DATABASE_URL="postgresql+psycopg2://your_db_username:your_db_password@localhost:5432/sih_attendance_test"

